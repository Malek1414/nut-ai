{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": false,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@nutai/totals": ["../../packages/totals/src/index.ts"],
      "@nutai/core-schema": ["../../packages/core-schema/src/index.ts"]
    }
  },
  "include": ["src", "../snapmenu-api/src/types.ts"]
}
